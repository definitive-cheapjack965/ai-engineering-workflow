# Normalize text files for cross-platform development
* text=auto eol=lf

# Markdown and text
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell / scripts
*.sh text eol=lf
*.ps1 text eol=lf

# Keep binary files untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
